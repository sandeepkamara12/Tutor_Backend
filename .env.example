# copy this file to .env and fill it in (never commit .env)
PORT=5000

# the address of your React site (CORS). In production: https://yourdomain.com
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (see README)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/russian-in-hindi?retryWrites=true&w=majority

# SMTP (Gmail example: use an "App password", not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-letter-app-password

# who receives the messages from the form, and the "from" name on the emails
MAIL_TO=youraddress@gmail.com
MAIL_FROM="Russian in Hindi <youraddress@gmail.com>"
